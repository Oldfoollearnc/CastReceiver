<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>CastReceiver.SelfTest</AssemblyName>
    <RootNamespace>CastReceiver.SelfTest</RootNamespace>
    <StartupObject>CastReceiver.SelfTest.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CastReceiver.Core\CastReceiver.Core.csproj" />
    <ProjectReference Include="..\..\src\CastReceiver.App\CastReceiver.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\sample.mp4" Link="Assets\sample.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>