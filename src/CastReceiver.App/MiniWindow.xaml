<Window x:Class="CastReceiver.App.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:CastReceiver.App.Interop"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="app.ico"
        Title="小窗" Width="384" Height="252" MinWidth="220" MinHeight="150"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="Manual"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType" Opacity="0">

    <!-- 无边框但保留 5px 边缘拖拽调整大小；标题栏高度设 0，
         拖动由画面上的鼠标按下触发（HwndHost 会把鼠标事件回投给 WPF）。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0"
                            CornerRadius="10" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="Frame" Background="{DynamicResource B.Bg}"
            BorderBrush="{DynamicResource B.Line}" BorderThickness="1" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 画面。注意：HwndHost 与 WPF 元素存在空域限制（WPF 画不到它上面），
                 所以控制条放在**下一行**而不是叠在画面上——这样既没有空域问题，
                 也不需要为它再开一个顶层窗口。 -->
            <ctrl:CompositionVideoHost x:Name="MiniHost" Grid.Row="0" />

            <!-- 控制条：高度**常驻 34px**，鼠标进出只做淡入淡出。
                 早先是把高度 0→34 做动画，但那会真的改变窗口尺寸、把 HwndHost 顶动一次（画面跳一下再重绘）；
                 所以改成常驻占位 + 只动透明度：窗口尺寸恒定，画面不再抖。
                 窗口高度同步 +34（见上面的 Height），保证视频区域仍是原来的 218。 -->
            <Border x:Name="Strip" Grid.Row="1" Height="34" ClipToBounds="True" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource B.MediaBar}"
                    BorderBrush="{DynamicResource B.MediaLine}" BorderThickness="0,1,0,0">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPin" Style="{StaticResource S.BtnIconMedia}" Content="&#xE718;"
                                Width="32" Click="BtnPin_Click" ToolTip="置顶显示"
                                AutomationProperties.Name="置顶显示" />
                        <Button x:Name="BtnShot" Style="{StaticResource S.BtnIconMedia}" Content="&#xE722;"
                                Width="32" Click="BtnShot_Click" ToolTip="截取当前画面"
                                AutomationProperties.Name="截屏" />
                        <!-- 多设备时才出现：在几路画面之间轮换（④） -->
                        <Button x:Name="BtnSwitch" Style="{StaticResource S.BtnIconMedia}" Content="&#xE8AB;"
                                Width="32" Click="BtnSwitch_Click" Visibility="Collapsed"
                                ToolTip="切换到下一台设备" AutomationProperties.Name="切换设备" />
                    </StackPanel>

                    <TextBlock x:Name="TxtState" Grid.Column="1" VerticalAlignment="Center"
                               HorizontalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource B.MediaTextDim}" TextTrimming="CharacterEllipsis"
                               Text="小窗" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnHome" Style="{StaticResource S.BtnIconMedia}" Content="&#xE8A7;"
                                Width="32" Click="BtnHome_Click" ToolTip="回到主窗口"
                                AutomationProperties.Name="回到主窗口" />
                        <Button x:Name="BtnClose" Style="{StaticResource S.BtnIconMedia}" Content="&#xE711;"
                                Width="32" Click="BtnClose_Click" ToolTip="关闭小窗"
                                AutomationProperties.Name="关闭小窗" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
