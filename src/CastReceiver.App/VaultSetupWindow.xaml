<Window x:Class="CastReceiver.App.VaultSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="创建加密账号" Height="620" Width="580"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource B.TextDim}" VerticalAlignment="Center"
                          Data="M10,2 A8,8 0 1 1 9.99,2 Z M9,5.5 H11 V11 H9 Z M9,12.5 H11 V14.5 H9 Z" />
                    <TextBlock Text="创建加密账号" Style="{DynamicResource S.H1}" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="&#xE8BB;" Style="{DynamicResource S.BtnClose}" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Click="BtnCancel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭" ToolTip="关闭（Esc）" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="26,4,26,0">
                <StackPanel>
                    <TextBlock x:Name="TxtIntro" FontSize="12" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" LineHeight="19"
                               Text="截图与录像加密保存在本机，只有这个账号的密码能查看。" />

                    <!-- 账号名 -->
                    <TextBlock Text="账号名" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,20,0,0" />
                    <Grid Margin="0,7,0,0">
                        <TextBox x:Name="TxtUser" Style="{StaticResource S.Field}" AutomationProperties.Name="账号名"
                                 CaretBrush="{DynamicResource B.Text}" TextChanged="User_TextChanged" />
                        <TextBlock x:Name="PhUser" Text="例如：我的账号" FontSize="13" Foreground="{DynamicResource B.TextFaint}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="2–32 个字符，只保存在本机。" FontSize="11"
                               Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap" />

                    <!-- 密码 -->
                    <TextBlock Text="密码" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,16,0,0" />
                    <Grid Margin="0,7,0,0">
                        <PasswordBox x:Name="TxtPassword" Style="{StaticResource S.FieldPwd}" AutomationProperties.Name="密码"
                                     CaretBrush="{DynamicResource B.Text}" PasswordChar="●"
                                     PasswordChanged="Password_Changed" />
                        <TextBlock x:Name="PhPassword" Text="至少 8 位，含字母和数字" FontSize="13" Foreground="{DynamicResource B.TextFaint}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Button x:Name="BtnPeek" Content="显示" Style="{DynamicResource S.Btn}" Padding="9,4" FontSize="11.5"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Click="BtnPeek_Click" />
                    </Grid>

                    <!-- 强度条 -->
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="4" CornerRadius="2" Background="{DynamicResource B.Line}" VerticalAlignment="Center">
                            <Border x:Name="StrengthBar" Height="4" CornerRadius="2" HorizontalAlignment="Left" Width="0"
                                    Background="{DynamicResource B.TextFaint}" />
                        </Border>
                        <TextBlock x:Name="TxtStrength" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" Text="未填写" />
                    </Grid>

                    <!-- 确认密码 -->
                    <TextBlock Text="再输一次" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,16,0,0" />
                    <Grid Margin="0,7,0,0">
                        <PasswordBox x:Name="TxtConfirm" Style="{StaticResource S.FieldPwd}" AutomationProperties.Name="再次输入密码"
                                     CaretBrush="{DynamicResource B.Text}" PasswordChar="●"
                                     PasswordChanged="Password_Changed" />
                        <TextBlock x:Name="PhConfirm" Text="再输一次密码" FontSize="13" Foreground="{DynamicResource B.TextFaint}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>

                    <!-- 提醒 -->
                    <Border Style="{DynamicResource S.Card}" Padding="12,11" Margin="0,18,0,0" Background="{DynamicResource B.Surface}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" Fill="{DynamicResource B.Warn}" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 Z M9,5.5 H11 V11.5 H9 Z M9,13 H11 V15 H9 Z" />
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="请务必记住这个密码" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.Warn}" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="18"
                                           Text="密码不保存、也找不回：忘记只能删号并清空内容。建议记进密码管理器。" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ErrorBox" CornerRadius="8" Background="{DynamicResource B.SurfaceHi}" Padding="11,9" Margin="0,14,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource B.Bad}" VerticalAlignment="Top" Margin="0,1,0,0"
                                  Data="M10,2 A8,8 0 1 1 9.99,2 Z M9,5 H11 V12 H9 Z M9,14 H11 V16 H9 Z" />
                            <TextBlock x:Name="TxtError" FontSize="12" Foreground="{DynamicResource B.Bad}" TextWrapping="Wrap"
                                       Margin="9,0,0,0" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="26,16,26,20">
                <TextBlock FontSize="11" Foreground="{DynamicResource B.TextFaint}" VerticalAlignment="Center"
                           Text="库位置：%LocalAppData%\CastReceiver\vault" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{DynamicResource S.Btn}" Padding="18,8" FontSize="12.5" Click="BtnCancel_Click" />
                    <Button x:Name="BtnCreate" Content="创建账号" Style="{DynamicResource S.BtnPrimary}" Padding="22,8" FontSize="12.5"
                            Margin="10,0,0,0" Click="BtnCreate_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
