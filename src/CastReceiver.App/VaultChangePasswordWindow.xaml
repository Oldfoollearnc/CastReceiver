<Window x:Class="CastReceiver.App.VaultChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="修改密码" Height="440" Width="520"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="修改账号密码" FontSize="13.5" FontWeight="SemiBold" Margin="20,0,0,0" VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{DynamicResource S.BtnIcon}" HorizontalAlignment="Right" Margin="0,0,10,0"
                        Click="BtnCancel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭" ToolTip="关闭（Esc）" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,10,24,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" LineHeight="19"
                           Text="改密码只是用新密码重新包裹账号私钥：已有的截图与录像不会被重新加密，也不需要重新导入。" />

                <TextBlock Text="账号" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,16,0,0" />
                <ComboBox x:Name="CmbAccount" Margin="0,6,0,0" Height="32" FontSize="12.5"
                          Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.Text}"
                          BorderBrush="{DynamicResource B.Line}" />

                <TextBlock Text="当前密码" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,14,0,0" />
                <PasswordBox x:Name="TxtOld" Margin="0,6,0,0" Padding="8,6" FontSize="12.5"
                             Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.Text}"
                             BorderBrush="{DynamicResource B.Line}" CaretBrush="{DynamicResource B.Text}" />

                <TextBlock Text="新密码" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,14,0,0" />
                <PasswordBox x:Name="TxtNew" Margin="0,6,0,0" Padding="8,6" FontSize="12.5"
                             Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.Text}"
                             BorderBrush="{DynamicResource B.Line}" CaretBrush="{DynamicResource B.Text}" />

                <TextBlock Text="再输一次新密码" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,14,0,0" />
                <PasswordBox x:Name="TxtConfirm" Margin="0,6,0,0" Padding="8,6" FontSize="12.5"
                             Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.Text}"
                             BorderBrush="{DynamicResource B.Line}" CaretBrush="{DynamicResource B.Text}" />

                <TextBlock x:Name="TxtError" FontSize="12" Foreground="{DynamicResource B.Bad}" Margin="0,12,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,18">
                <Button Content="取消" Style="{DynamicResource S.Btn}" Padding="16,7" FontSize="12" Click="BtnCancel_Click" />
                <Button x:Name="BtnApply" Content="修改密码" Style="{DynamicResource S.BtnPrimary}" Padding="18,7" FontSize="12"
                        Margin="10,0,0,0" Click="BtnApply_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
