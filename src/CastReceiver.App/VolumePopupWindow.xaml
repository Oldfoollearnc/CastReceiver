<Window x:Class="CastReceiver.App.VolumePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="音量" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        MinWidth="1" MinHeight="1"
        FontFamily="{DynamicResource F.Ui}" Foreground="{DynamicResource B.MediaText}" WindowStartupLocation="Manual">

    <!-- 电脑音量弹层：浮在悬浮控制条上方的一小块。
         独立顶层窗口的理由和悬浮条一样 —— 画面是 HwndHost，WPF 元素盖不住它。
         调的是**这台电脑**的播放音量（镜像的声音是电脑在放），不是手机音量。 -->
    <Border Background="{DynamicResource B.MediaBar}" BorderBrush="{DynamicResource B.MediaLine}" BorderThickness="1"
            CornerRadius="14" Padding="10,8" MouseLeftButtonDown="OnDrag" MouseWheel="OnWheel">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnMute" Style="{StaticResource S.BtnIconMedia}" Content="&#xE767;" Click="BtnMute_Click"
                    AutomationProperties.Name="静音" ToolTip="静音 / 取消静音" />

            <Slider x:Name="SldVolume" Style="{StaticResource S.SliderMedia}" Width="150" Margin="10,0,10,0"
                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                    AutomationProperties.Name="电脑音量" ValueChanged="SldVolume_ValueChanged" />

            <TextBlock x:Name="TxtLevel" Text="—" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                       FontFamily="{DynamicResource F.Mono}" FontSize="11.5" Foreground="{DynamicResource B.MediaTextDim}" />
        </StackPanel>
    </Border>
</Window>