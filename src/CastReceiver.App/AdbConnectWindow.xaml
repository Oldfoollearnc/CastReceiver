<Window x:Class="CastReceiver.App.AdbConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="鼠标控制（安卓）" Height="640" Width="560"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="用鼠标控制手机（安卓 · 无线调试）" Style="{DynamicResource S.H1}"
                           Margin="20,0,0,0" VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{DynamicResource S.BtnClose}" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭" ToolTip="关闭（Esc）" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,8,24,0">
                <!-- 当前状态：连没连上、哪台手机、什么系统 —— 不支持的情况在这里明确写出来 -->
                <Border Style="{DynamicResource S.Card}" Padding="12,10" Background="{DynamicResource B.Surface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotState" Width="7" Height="7" Fill="{DynamicResource B.TextFaint}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtState" FontSize="12.5" FontWeight="SemiBold" Margin="7,0,0,0"
                                       TextWrapping="Wrap" AutomationProperties.AutomationId="AdbDialogState" />
                        </StackPanel>
                        <TextBlock x:Name="TxtDevice" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                                   Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.AutomationId="AdbDialogDevice" />
                        <TextBlock x:Name="TxtAdbPath" FontSize="10.5" Foreground="{DynamicResource B.TextFaint}"
                                   FontFamily="{DynamicResource F.Mono}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="AdbDialogPath" />
                    </StackPanel>
                </Border>

                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="18"
                           Text="平时什么都不用填：手机打开「设置 → 开发者选项 → 无线调试」，本程序会自动发现并连上（投屏后打开「鼠标控制」开关即可）。只有第一次在一台新手机上用时需要配对一次 —— 在手机上点「使用配对码配对设备」，把 6 位配对码填进下面（IP 与配对端口会自动填好）。需要 Android 11 及以上。" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnAuto" Content="自动发现并连接" Style="{DynamicResource S.BtnPrimary}" Padding="16,7"
                            FontSize="12" Click="BtnAuto_Click" AutomationProperties.Name="自动发现并连接"
                            AutomationProperties.AutomationId="AdbAutoButton" />
                    <Button x:Name="BtnDiscover" Content="只刷新发现结果" Style="{DynamicResource S.Btn}" Padding="12,7"
                            FontSize="12" Margin="10,0,0,0" Click="BtnDiscover_Click" AutomationProperties.Name="自动发现同网段手机"
                            AutomationProperties.AutomationId="AdbDiscoverButton" />
                    <Button x:Name="BtnDisconnect" Content="断开" Style="{DynamicResource S.Btn}" Padding="12,7"
                            FontSize="12" Margin="10,0,0,0" Click="BtnDisconnect_Click" AutomationProperties.Name="断开"
                            AutomationProperties.AutomationId="AdbDisconnectButton" />
                </StackPanel>

                <TextBlock Text="首次配对（只做一次）" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,14,0,0" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="手机 IP 地址（自动填）" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" />
                        <TextBox x:Name="TxtHost" Margin="0,6,0,0" AutomationProperties.Name="手机 IP 地址"
                                 AutomationProperties.AutomationId="AdbHostInput" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="连接端口（自动填）" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" />
                        <TextBox x:Name="TxtConnectPort" Margin="0,6,0,0" AutomationProperties.Name="连接端口"
                                 AutomationProperties.AutomationId="AdbConnectPortInput" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="配对端口（自动填）" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" />
                        <TextBox x:Name="TxtPairPort" Margin="0,6,0,0" AutomationProperties.Name="配对端口"
                                 AutomationProperties.AutomationId="AdbPairPortInput" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="配对码（手机上显示的 6 位）" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" />
                        <TextBox x:Name="TxtPairCode" Margin="0,6,0,0" AutomationProperties.Name="配对码"
                                 AutomationProperties.AutomationId="AdbPairCodeInput" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button x:Name="BtnPair" Content="配对并连接" Style="{DynamicResource S.BtnPrimary}" Padding="14,7"
                            FontSize="12" Click="BtnPair_Click" AutomationProperties.Name="配对并连接"
                            AutomationProperties.AutomationId="AdbPairButton" />
                    <Button x:Name="BtnConnect" Content="仅用上面的端口连接" Style="{DynamicResource S.Btn}" Padding="12,7"
                            FontSize="12" Margin="10,0,0,0" Click="BtnConnect_Click" AutomationProperties.Name="连接"
                            AutomationProperties.AutomationId="AdbConnectButton" />
                    <Button x:Name="BtnDiagnose" Content="复制诊断信息" Style="{DynamicResource S.Btn}" Padding="12,7"
                            FontSize="12" Margin="10,0,0,0" Click="BtnDiagnose_Click" AutomationProperties.Name="复制诊断信息"
                            AutomationProperties.AutomationId="AdbDiagnoseButton"
                            ToolTip="把电脑网络、adb 版本、发现到的服务、失败原因等复制出来（排查用）" />
                </StackPanel>

                <TextBlock Text="adb 输出" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,14,0,0" />
                <Border Style="{DynamicResource S.Card}" Padding="10,8" Margin="0,6,0,0" Height="118"
                        Background="{DynamicResource B.BgSoft}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtOutput" FontSize="10.5" FontFamily="{DynamicResource F.Mono}"
                                   Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AdbDialogOutput" />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12,24,16">
                <Button Content="关闭" Style="{DynamicResource S.Btn}" Padding="16,7" FontSize="12" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
