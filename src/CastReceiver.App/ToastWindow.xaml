<Window x:Class="CastReceiver.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MaxWidth="400" MaxHeight="200" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" FontFamily="{DynamicResource F.Ui}" Foreground="{DynamicResource B.Text}">
    <Border Background="{DynamicResource B.OverlayBgSoft}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
            CornerRadius="12" Padding="14,12">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource B.Ok}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtTitle" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <!-- 正文限高 + 省略号：提示条会从右下角往上长，不限高就会一路盖住画面 -->
            <TextBlock x:Name="TxtBody" FontSize="11.5" Foreground="{DynamicResource B.TextDim}" Margin="15,6,0,0"
                       TextWrapping="Wrap" MaxWidth="330" MaxHeight="104" TextTrimming="CharacterEllipsis" />
            <Button x:Name="BtnAction" Style="{DynamicResource S.Btn}" Margin="15,10,0,0" HorizontalAlignment="Left"
                    Padding="12,6" FontSize="12" Visibility="Collapsed" Click="BtnAction_Click" />
        </StackPanel>
    </Border>
</Window>