<Window x:Class="CastReceiver.App.DiagnosticWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接诊断" Width="560" SizeToContent="Height" MaxHeight="640" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize"
        Topmost="True" WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource F.Ui}"
        Foreground="{DynamicResource B.Text}">
    <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
            CornerRadius="16" Padding="24,20">
        <StackPanel>
            <!-- 标题与右侧拖动提示分列，避免同格叠放（标题变长时会压住提示） -->
            <Grid MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="连接诊断" Style="{DynamicResource S.H1}" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="拖动可移动窗口" FontSize="11" Foreground="{DynamicResource B.TextFaint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="TxtProgress" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0" Text="准备中…" />

            <ScrollViewer x:Name="Scroll" MaxHeight="380" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Results" />
            </ScrollViewer>

            <Border Background="{DynamicResource B.SurfaceHi}" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                <TextBlock x:Name="TxtVerdict" FontSize="12" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"
                           Visibility="Collapsed" LineHeight="20" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="BtnClose" Style="{DynamicResource S.BtnPrimary}" Content="关闭" Click="BtnClose_Click"
                        AutomationProperties.Name="关闭诊断" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>