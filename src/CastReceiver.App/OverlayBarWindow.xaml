<!-- MinWidth / MinHeight 显式给 1：WPF 给顶层窗口的默认最小跟踪尺寸是
     SystemParameters.MinimumWindowWidth（本机 136），这条只有三个按钮的窄条一创建就被撑成
     136 宽 —— 右边空出 20 多像素，看着就不像"一条"。给小值才能让它老老实实按内容收窄。 -->
<Window x:Class="CastReceiver.App.OverlayBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="控制条" SizeToContent="WidthAndHeight" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        MinWidth="1" MinHeight="1"
        FontFamily="{DynamicResource F.Ui}" Foreground="{DynamicResource B.MediaText}" WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- 条上的图标按钮：32×32 点击区，悬停出圆角底（和舞台上其它按钮同一套） -->
        <Style x:Key="S.BarBtn" TargetType="Button" BasedOn="{StaticResource S.BtnIconMedia}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="1,0" />
        </Style>
    </Window.Resources>

    <!-- 悬浮控制条：独立顶层窗口，不受 HwndHost 空域限制，窗口模式与全屏模式下都能浮在画面上。
         极简：只剩"别处没有"的动作 —— 截屏 / 录制 / 小窗（全屏时多一个"退出全屏"，
         因为那时舞台顶栏是收起的）。
         全屏 / 适配 / 缩放都已经长在舞台顶栏上，这里不再重复一份：按钮少了就直接全摆出来，
         不需要收进"更多"里再点一下。 -->
    <Border x:Name="Card" Background="{DynamicResource B.MediaBar}" BorderBrush="{DynamicResource B.MediaLine}"
            BorderThickness="1" CornerRadius="14" Padding="5,5" MouseLeftButtonDown="OnDrag">
        <!-- 右键：常用功能的菜单（条上放不下的、偶尔才用的都收在这里） -->
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource S.BarMenu}">
                <MenuItem x:Name="MiShot" Header="截屏" Tag="&#xE722;" InputGestureText="Ctrl+Alt+S"
                          Style="{StaticResource S.BarMenuItem}" Click="MiShot_Click" />
                <MenuItem x:Name="MiRec" Header="开始录制" Tag="&#xE7C8;" InputGestureText="Ctrl+Alt+R"
                          Style="{StaticResource S.BarMenuItem}" Click="MiRec_Click" />
                <MenuItem x:Name="MiMini" Header="小窗显示" Tag="&#xE7C4;"
                          Style="{StaticResource S.BarMenuItem}" Click="MiMini_Click" />
                <Separator Style="{StaticResource S.BarMenuSep}" />
                <MenuItem x:Name="MiMute" Header="静音" Tag="&#xE767;"
                          Style="{StaticResource S.BarMenuItem}" Click="MiMute_Click" />
                <MenuItem x:Name="MiFullscreen" Header="进入全屏" Tag="&#xE740;" InputGestureText="F11 / 双击画面"
                          Style="{StaticResource S.BarMenuItem}" Click="MiFullscreen_Click" />
                <Separator Style="{StaticResource S.BarMenuSep}" />
                <MenuItem x:Name="MiSettings" Header="设置…" Tag="&#xE713;"
                          Style="{StaticResource S.BarMenuItem}" Click="MiSettings_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- 只在全屏时出现：全屏下舞台顶栏是收起的，退出的入口就只有这里和 Esc -->
            <Button x:Name="BtnExitFullscreen" Style="{StaticResource S.BarBtn}" Content="&#xE73F;" Visibility="Collapsed"
                    Click="BtnExitFullscreen_Click"
                    AutomationProperties.Name="退出全屏" ToolTip="退出全屏（双击画面或按 Esc）" />

            <Border x:Name="FsDivider" Width="1" Height="18" Background="{DynamicResource B.MediaLine}"
                    Margin="6,0,7,0" Visibility="Collapsed" />

            <!-- 全屏时的画面适配：窗口模式下这套在舞台顶栏上，这里只在全屏出现，
                 补上"全屏后无法调拉伸/原始/比例"这个缺口。菜单里同时有缩放。 -->
            <Button x:Name="BtnFit" Style="{StaticResource S.BarBtn}" Content="&#xE9A6;" Visibility="Collapsed"
                    Click="BtnFit_Click" AutomationProperties.Name="画面适配"
                    ToolTip="画面适配（自动 / 适应 / 铺满 / 拉伸 / 原始 / 缩放）">
                <Button.ContextMenu>
                    <ContextMenu Style="{StaticResource S.BarMenu}">
                        <MenuItem x:Name="MiFitAuto" Header="自动适配（不裁切）" Style="{StaticResource S.BarMenuItem}" Click="MiFitMode_Click" />
                        <Separator Style="{StaticResource S.BarMenuSep}" />
                        <MenuItem x:Name="MiFitFit" Header="适应（完整显示）" Style="{StaticResource S.BarMenuItem}" Click="MiFitMode_Click" />
                        <MenuItem x:Name="MiFitFill" Header="铺满（裁切边缘）" Style="{StaticResource S.BarMenuItem}" Click="MiFitMode_Click" />
                        <MenuItem x:Name="MiFitStretch" Header="拉伸（填满整块）" Style="{StaticResource S.BarMenuItem}" Click="MiFitMode_Click" />
                        <MenuItem x:Name="MiFitNative" Header="原始 1:1（超出裁切）" Style="{StaticResource S.BarMenuItem}" Click="MiFitMode_Click" />
                        <Separator Style="{StaticResource S.BarMenuSep}" />
                        <MenuItem x:Name="MiZoomIn" Header="放大画面" InputGestureText="+" Style="{StaticResource S.BarMenuItem}" Click="MiZoomIn_Click" />
                        <MenuItem x:Name="MiZoomOut" Header="缩小画面" InputGestureText="-" Style="{StaticResource S.BarMenuItem}" Click="MiZoomOut_Click" />
                        <MenuItem x:Name="MiZoomReset" Header="缩放复位 100%" Style="{StaticResource S.BarMenuItem}" Click="MiZoomReset_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Border x:Name="FitDivider" Width="1" Height="18" Background="{DynamicResource B.MediaLine}"
                    Margin="6,0,7,0" Visibility="Collapsed" />

            <!-- 电脑音量（不是手机音量）：点开滑杆弹层，滚轮直接在图标上调 -->
            <Button x:Name="BtnVolume" Style="{StaticResource S.BarBtn}" Content="&#xE767;" Click="BtnVolume_Click"
                    MouseWheel="BtnVolume_Wheel"
                    AutomationProperties.Name="电脑音量" ToolTip="电脑音量（点开滑杆，滚轮直接调）" />

            <Border Width="1" Height="18" Background="{DynamicResource B.MediaLine}" Margin="6,0,7,0" />

            <Button x:Name="BtnShot" Style="{StaticResource S.BarBtn}" Content="&#xE722;" Click="BtnShot_Click"
                    AutomationProperties.Name="截屏" ToolTip="截取当前画面（Ctrl+Alt+S）" />

            <Button x:Name="BtnRec" Style="{StaticResource S.BarBtn}" Content="&#xE7C8;" Click="BtnRec_Click"
                    AutomationProperties.Name="录制" ToolTip="开始 / 停止录制（Ctrl+Alt+R）" />

            <!-- 小窗：这里是"手动打开"的入口（画中画，不受设置影响）。
                 "主窗口最小化时是否自动出现"由 设置 → 画面 的开关决定。 -->
            <Button x:Name="BtnMini" Style="{StaticResource S.BarBtn}" Content="&#xE7C4;" Click="BtnMini_Click"
                    AutomationProperties.Name="小窗"
                    ToolTip="小窗显示画面（画中画；最小化时是否自动弹出见 设置 → 画面）" />
        </StackPanel>
    </Border>
</Window>