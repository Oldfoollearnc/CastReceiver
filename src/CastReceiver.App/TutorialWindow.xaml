<Window x:Class="CastReceiver.App.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用引导" Width="560" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource F.Ui}"
        Foreground="{DynamicResource B.Text}">

    <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="16" Padding="28,24">
        <StackPanel>
            <!-- 步骤指示：一条会随动画推进的进度条 -->
            <Grid Height="3" Margin="0,0,0,22">
                <Border Background="{DynamicResource B.SurfaceHi}" CornerRadius="2" />
                <Border x:Name="ProgressBarFill" Background="{DynamicResource B.Text}" CornerRadius="2"
                        HorizontalAlignment="Left" Width="0" />
            </Grid>

            <!-- 图标 -->
            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource B.SurfaceHi}" HorizontalAlignment="Center">
                <Path x:Name="StepIcon" Width="32" Height="32" Stretch="Uniform" Stroke="{DynamicResource B.Text}"
                      StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M8,2 H24 A2,2 0 0 1 26,4 V20 A2,2 0 0 1 24,22 H8 A2,2 0 0 1 6,20 V4 A2,2 0 0 1 8,2 Z M2,6 A1,1 0 0 1 4,6 A8,8 0 0 0 12,14 A1,1 0 0 1 12,16 A10,10 0 0 1 2,6 Z M2,11 A1,1 0 0 1 4,11 A3,3 0 0 0 7,14 A1,1 0 0 1 7,16 A5,5 0 0 1 2,11 Z M3,15.2 A1.4,1.4 0 1 1 3,18 A1.4,1.4 0 0 1 3,15.2 Z" />
            </Border>

            <!-- 文案（切换步骤时淡入 + 轻微上移） -->
            <StackPanel x:Name="StepText" HorizontalAlignment="Center" Margin="0,20,0,0">
                <StackPanel.RenderTransform><TranslateTransform x:Name="StepShift" Y="0" /></StackPanel.RenderTransform>
                <TextBlock x:Name="TxtStepTitle" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtStepBody" FontSize="12.5" Foreground="{DynamicResource B.TextDim}" Margin="0,10,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" LineHeight="20" />
            </StackPanel>

            <!-- 步骤点 -->
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0" />

            <!-- 按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="BtnSkip" Style="{StaticResource S.Btn}" Content="跳过" Padding="16,7"
                        AutomationProperties.Name="跳过" Click="BtnSkip_Click" />
                <Button x:Name="BtnNext" Style="{StaticResource S.BtnPrimary}" Content="下一步" Margin="10,0,0,0" Padding="18,7"
                        AutomationProperties.Name="下一步" Click="BtnNext_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>