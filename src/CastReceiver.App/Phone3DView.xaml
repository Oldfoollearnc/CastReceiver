<UserControl x:Class="CastReceiver.App.Phone3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" IsHitTestVisible="False" ClipToBounds="False">
    <!--
        空态里的 3D 手机：不是"数字大屏"，而是一件静态产品渲染。
        石墨灰机身 + 左侧主光 + 右侧很弱的轮廓光，屏幕上没有任何彩色内容。
        只在待机时缓慢自转；鼠标移动时有一点点视差（±14° / ±8°），不抢戏。
    -->
    <Viewport3D x:Name="Viewport" ClipToBounds="False">
        <Viewport3D.Camera>
            <PerspectiveCamera Position="0,0,3.5" LookDirection="0,0,-3.5" UpDirection="0,1,0" FieldOfView="30" />
        </Viewport3D.Camera>

        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#FF35383F" />
                    <DirectionalLight Color="#FFD6D9DF" Direction="-0.45,-0.65,-1" />
                    <DirectionalLight Color="#FF5A616C" Direction="0.85,0.25,-0.55" />
                    <DirectionalLight Color="#FF24272C" Direction="0.1,1,-0.3" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>

        <ModelVisual3D x:Name="ModelRoot">
            <ModelVisual3D.Transform>
                <Transform3DGroup>
                    <RotateTransform3D x:Name="TiltX">
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D Axis="1,0,0" Angle="7" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                    <RotateTransform3D x:Name="SpinY">
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D Axis="0,1,0" Angle="-18" />
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                    <TranslateTransform3D x:Name="ModelFloat" OffsetX="0" OffsetY="0" OffsetZ="0" />
                    <ScaleTransform3D x:Name="ModelScale" ScaleX="1" ScaleY="1" ScaleZ="1" />
                </Transform3DGroup>
            </ModelVisual3D.Transform>
        </ModelVisual3D>
    </Viewport3D>
</UserControl>
