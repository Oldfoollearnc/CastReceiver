<!-- 浅色主题：冷调米白，卡片比内容面更亮一档，靠明度分层不靠阴影 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Name">Light</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Label">浅色</sys:String>

    <!-- 底层画布 → 内容面 → 卡片 → 抬起/悬停：四级明度，差一点点就够 -->
    <SolidColorBrush x:Key="B.Bg" Color="#F7F8FA" />
    <SolidColorBrush x:Key="B.BgSoft" Color="#F1F3F6" />
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SurfaceHi" Color="#ECEFF3" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#E2E6EC" />
    <SolidColorBrush x:Key="B.SurfacePress" Color="#D7DCE4" />
    <SolidColorBrush x:Key="B.Line" Color="#E1E5EB" />
    <SolidColorBrush x:Key="B.LineSoft" Color="#ECEFF3" />
    <SolidColorBrush x:Key="B.Text" Color="#14171B" />
    <SolidColorBrush x:Key="B.TextDim" Color="#5B636D" />
    <SolidColorBrush x:Key="B.TextFaint" Color="#8B939D" />
    <SolidColorBrush x:Key="B.Ok" Color="#12A150" />
    <SolidColorBrush x:Key="B.Warn" Color="#B26A00" />
    <SolidColorBrush x:Key="B.Bad" Color="#D2453C" />
    <SolidColorBrush x:Key="B.Accent" Color="#14171B" />
    <SolidColorBrush x:Key="B.AccentText" Color="#FFFFFF" />
    <!-- 强调色的两种弱化：底色（选中/标签）与描边（聚焦环）—— 运行时跟着强调色走，见 App.ApplyAccent -->
    <SolidColorBrush x:Key="B.AccentSoft" Color="#243DDC97" />
    <SolidColorBrush x:Key="B.AccentLine" Color="#663DDC97" />
    <SolidColorBrush x:Key="B.FocusRing" Color="#553DDC97" />
    <SolidColorBrush x:Key="B.VideoBg" Color="#000000" />
    <SolidColorBrush x:Key="B.OverlayBg" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="B.OverlayBgSoft" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="B.SwitchTrackOff" Color="#CFD5DD" />
    <SolidColorBrush x:Key="B.SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.ScrollThumb" Color="#C7CDD6" />
    <SolidColorBrush x:Key="B.BusyOverlay" Color="#F2F7F8FA" />
    <SolidColorBrush x:Key="B.WindowMica" Color="#D9F7F8FA" />

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashBg">#F7F8FA</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashFg">#14171B</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashDim">#5B636D</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashLine">#E1E5EB</sys:String>
</ResourceDictionary>
