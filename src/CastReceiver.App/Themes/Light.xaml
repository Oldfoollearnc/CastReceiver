<!-- 浅色主题：柔和米白，不用刺眼的纯白大面积 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Name">Light</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Label">浅色</sys:String>

    <SolidColorBrush x:Key="B.Bg" Color="#F4F5F7" />
    <SolidColorBrush x:Key="B.BgSoft" Color="#EDEFF2" />
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SurfaceHi" Color="#ECEEF1" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#E2E5EA" />
    <SolidColorBrush x:Key="B.Line" Color="#DCE0E5" />
    <SolidColorBrush x:Key="B.LineSoft" Color="#E8EBEF" />
    <SolidColorBrush x:Key="B.Text" Color="#16181C" />
    <SolidColorBrush x:Key="B.TextDim" Color="#5A6169" />
    <SolidColorBrush x:Key="B.TextFaint" Color="#8A9199" />
    <SolidColorBrush x:Key="B.Ok" Color="#12A150" />
    <SolidColorBrush x:Key="B.Warn" Color="#B26A00" />
    <SolidColorBrush x:Key="B.Bad" Color="#D2453C" />
    <SolidColorBrush x:Key="B.Accent" Color="#16181C" />
    <SolidColorBrush x:Key="B.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.VideoBg" Color="#000000" />
    <SolidColorBrush x:Key="B.OverlayBg" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="B.OverlayBgSoft" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="B.SwitchTrackOff" Color="#CBD1D8" />
    <SolidColorBrush x:Key="B.SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.ScrollThumb" Color="#C4CAD2" />
    <SolidColorBrush x:Key="B.BusyOverlay" Color="#F2F3F5F7" />
    <SolidColorBrush x:Key="B.WindowMica" Color="#D9F4F5F7" />

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashBg">#F4F5F7</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashFg">#16181C</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashDim">#5A6169</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashLine">#DCE0E5</sys:String>
</ResourceDictionary>