<!--
    浅色主题 · 极简中性（Minimal）

    与原来的浅色主题一致：冷调米白、白卡片、细描边，层级只靠明度与留白。
    新增的语义键（SurfaceGlass / Aurora* / Glow*）在这里一律退化成中性色或透明，
    组件层不需要再改，也不会冒出任何装饰性渐变。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Name">Light</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Label">浅色</sys:String>

    <!-- ============================================================ 底色 -->
    <SolidColorBrush x:Key="B.Bg" Color="#F7F8FA" />
    <SolidColorBrush x:Key="B.BgSoft" Color="#F1F3F6" />
    <SolidColorBrush x:Key="B.WindowBg" Color="#F7F8FA" />

    <!-- ============================================================ 面 -->
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SurfaceHi" Color="#ECEFF3" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#E2E6EC" />
    <SolidColorBrush x:Key="B.SurfacePress" Color="#D7DCE4" />
    <SolidColorBrush x:Key="B.Line" Color="#E1E5EB" />
    <SolidColorBrush x:Key="B.LineSoft" Color="#ECEFF3" />

    <SolidColorBrush x:Key="B.SurfaceGlass" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.SurfaceGlassHi" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.GlassLine" Color="#E1E5EB" />
    <SolidColorBrush x:Key="B.GlassLineSoft" Color="#ECEFF3" />

    <!-- ============================================================ 文字 -->
    <SolidColorBrush x:Key="B.Text" Color="#14171B" />
    <SolidColorBrush x:Key="B.TextDim" Color="#5B636D" />
    <SolidColorBrush x:Key="B.TextFaint" Color="#646C76" />

    <SolidColorBrush x:Key="B.Ok" Color="#0F7A3D" />
    <SolidColorBrush x:Key="B.Warn" Color="#8F5600" />
    <SolidColorBrush x:Key="B.Bad" Color="#D2453C" />

    <!-- ============================================================ 强调色（运行时由 ApplyAccent 覆盖） -->
    <SolidColorBrush x:Key="B.Accent" Color="#14171B" />
    <SolidColorBrush x:Key="B.AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#243DDC97" />
    <SolidColorBrush x:Key="B.AccentLine" Color="#663DDC97" />
    <SolidColorBrush x:Key="B.FocusRing" Color="#993DDC97" />

    <SolidColorBrush x:Key="B.AuroraBrush" Color="#14171B" />
    <SolidColorBrush x:Key="B.AuroraBrushH" Color="#14171B" />
    <SolidColorBrush x:Key="B.AuroraSoft" Color="#243DDC97" />
    <SolidColorBrush x:Key="B.AuroraLine" Color="#663DDC97" />
    <SolidColorBrush x:Key="B.GlowViolet" Color="#00000000" />
    <SolidColorBrush x:Key="B.GlowCyan" Color="#00000000" />
    <SolidColorBrush x:Key="B.GlowMint" Color="#00000000" />
    <SolidColorBrush x:Key="B.HeroWash" Color="#00000000" />
    <SolidColorBrush x:Key="B.StageWash" Color="#000000" />
    <SolidColorBrush x:Key="B.NavActive" Color="#1F3DDC97" />

    <!-- ============================================================ 浮层 / 控件细节 -->
    <SolidColorBrush x:Key="B.VideoBg" Color="#000000" />
    <SolidColorBrush x:Key="B.OverlayBg" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="B.OverlayBgSoft" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="B.SwitchTrackOff" Color="#CFD5DD" />
    <SolidColorBrush x:Key="B.SwitchKnob" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.ScrollThumb" Color="#C7CDD6" />
    <SolidColorBrush x:Key="B.BusyOverlay" Color="#F2F7F8FA" />
    <SolidColorBrush x:Key="B.WindowMica" Color="#D9F7F8FA" />

    <!-- 媒体语境浮层：与深色主题取值**完全相同**（舞台恒黑） -->
    <SolidColorBrush x:Key="B.MediaBar" Color="#E6121418" />
    <SolidColorBrush x:Key="B.MediaBarSoft" Color="#CC0E1013" />
    <SolidColorBrush x:Key="B.MediaLine" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="B.MediaText" Color="#EDEEF1" />
    <SolidColorBrush x:Key="B.MediaTextDim" Color="#A5ABB4" />
    <SolidColorBrush x:Key="B.MediaBtn" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="B.MediaBtnHover" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="B.MediaBtnPress" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="B.MediaOk" Color="#34D399" />
    <SolidColorBrush x:Key="B.MediaWarn" Color="#F2B455" />
    <SolidColorBrush x:Key="B.MediaBad" Color="#F87171" />

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashBg">#F7F8FA</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashFg">#14171B</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashDim">#5B636D</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashLine">#E1E5EB</sys:String>
</ResourceDictionary>
