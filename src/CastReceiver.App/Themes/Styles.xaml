<!--
    设计系统 · 控件样式（极光玻璃）

    改这里的规矩：
      · 颜色一律 DynamicResource 引用主题键，切换主题即时生效；不要在控件里写死颜色。
      · 层级靠"面的明度差 + 1px 冷色描边 + 留白"，不靠投影（WPF 大量投影会拖慢动画）。
      · 动效只走 Opacity / TranslateTransform / ScaleTransform，并且 FillBehavior=Stop，
        避免动画把属性锁死（详见 Motion.cs 顶部说明）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="F.Ui">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Duration x:Key="D.Fast">0:0:0.12</Duration>
    <Duration x:Key="D.Normal">0:0:0.22</Duration>
    <Duration x:Key="D.Slow">0:0:0.42</Duration>

    <!-- 全局窗口默认：字体、渲染质量、布局取整。背景留给各窗口自己决定（浮层要透明）。 -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ============================================================ 键盘焦点环
         自绘模板把系统默认的焦点虚线吃掉了（ListBoxItem 甚至显式设成 null），
         键盘用户因此完全看不到焦点在哪。这里统一补一个两层环：
           · 外层光晕用 B.FocusRing（跟随强调色）
           · 内层描边用 B.Text —— 强调色里 Rose #F472B6 对白底只有 2.65:1，
             达不到 WCAG 对焦点指示 3:1 的要求；B.Text 在深浅两套主题下都 ≥15:1。 -->
    <Style x:Key="S.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-4" IsHitTestVisible="False">
                        <Rectangle RadiusX="13" RadiusY="13" Fill="{DynamicResource B.FocusRing}" />
                        <Rectangle RadiusX="10" RadiusY="10" Margin="2" Stroke="{DynamicResource B.Text}"
                                   StrokeThickness="2" SnapsToDevicePixels="True" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 文字层级
         展示标题 26 / 页面标题 16 / 分组标题 13 / 正文 13 / 说明 12 / 小字 11.5。 -->
    <Style x:Key="S.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>
    <Style x:Key="S.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>
    <Style x:Key="S.H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>
    <Style x:Key="S.H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>
    <Style x:Key="S.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>
    <Style x:Key="S.Desc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="S.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
    </Style>
    <Style x:Key="S.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="S.Value" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="S.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
    </Style>
    <Style x:Key="S.Number" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}" />
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
    </Style>

    <!-- ============================================================ 容器 -->
    <Style x:Key="S.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- 实心卡片：需要压住底下视频/浮层的地方用 -->
    <Style x:Key="S.CardSolid" TargetType="Border" BasedOn="{StaticResource S.Card}">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
    </Style>

    <!-- 舞台卡片：永远是黑的，浅色主题也一样 -->
    <Style x:Key="S.Stage" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.VideoBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- 卡片里的内嵌面（比卡片再深/浅一档，用来放输入、列表、强调块） -->
    <Style x:Key="S.Inset" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.BgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="S.Pill" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.SurfaceHi}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- 强调标签：状态词、选中项 -->
    <Style x:Key="S.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,4" />
    </Style>

    <Style x:Key="S.ChipNeutral" TargetType="Border" BasedOn="{StaticResource S.Chip}">
        <Setter Property="Background" Value="{DynamicResource B.SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
    </Style>

    <!-- 小徽标：品牌版本 / 数量角标 -->
    <Style x:Key="S.Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- 统计小块：延迟 / 画质 / 丢帧 -->
    <Style x:Key="S.Stat" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.BgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.LineSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- 图标底座：中性面，放在空态/设置分组标题旁边 -->
    <Style x:Key="S.IconBadge" TargetType="Border">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource B.SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="S.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource B.LineSoft}" />
    </Style>

    <!-- 极光细线：品牌签名，用在顶栏下沿 / 进度线 -->
    <Style x:Key="S.AuroraRule" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource B.AuroraLine}" />
    </Style>

    <!-- ============================================================ 按钮
         次级＝面 + 细边；主操作＝强调色实心；幽灵＝只有悬停底色。
         悬停/按下的缩放是"微交互"，幅度很小（1.2% / 2.5%），只为手感，不为炫技。 -->
    <Style x:Key="S.Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.SurfaceHi}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHover}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.GlassLine}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.006" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.006" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfacePress}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.99" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.99" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮：强调色实心 + 极细的强调色外圈（不是投影，只有 2px） -->
    <Style x:Key="S.BtnPrimary" TargetType="Button" BasedOn="{StaticResource S.Btn}">
        <Setter Property="Background" Value="{DynamicResource B.Accent}" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.92" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1.008" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1.008" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.82" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="0.99" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="0.99" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="scale" Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 幽灵按钮：没有边框，只有悬停底色（次要动作、链接式入口） -->
    <Style x:Key="S.Ghost" TargetType="Button" BasedOn="{StaticResource S.Btn}">
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮：删除 / 清空这类不可逆操作。 -->
    <Style x:Key="S.BtnDanger" TargetType="Button" BasedOn="{StaticResource S.Btn}">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Bad}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Bad}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="11">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.Bad}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Surface}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮：正方形点击区，悬停出圆角底 -->
    <Style x:Key="S.BtnIcon" TargetType="Button" BasedOn="{StaticResource S.Btn}">
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{DynamicResource F.Icon}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 窗口按钮：跟图标按钮同形，但关闭键悬停变红 -->
    <Style x:Key="S.BtnChrome" TargetType="Button" BasedOn="{StaticResource S.BtnIcon}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="#00000000" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="S.BtnClose" TargetType="Button" BasedOn="{StaticResource S.BtnChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="#00000000" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#E5484D" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C93C41" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 动作磁贴：图标 + 文字的方块（快捷操作那一排） -->
    <Style x:Key="S.BtnTile" TargetType="Button" BasedOn="{StaticResource S.Btn}">
        <Setter Property="Background" Value="{DynamicResource B.SurfaceHi}" />
        <Setter Property="BorderBrush" Value="#00000000" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="11">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfacePress}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 媒体语境按钮
         给"浮在画面之上"的控制条用（悬浮控制条 / 小窗控制条 / 舞台顶栏）。刻意不用主题色：
         舞台恒黑，浅色主题下用主题色会变成浅底深字的白条压在黑画面上。 -->
    <Style x:Key="S.BtnMedia" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource B.MediaText}" />
        <Setter Property="Background" Value="{DynamicResource B.MediaBtn}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.MediaBtnHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.MediaBtnPress}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 媒体语境图标按钮：正方形点击区，悬停出圆角底 -->
    <Style x:Key="S.BtnIconMedia" TargetType="Button" BasedOn="{StaticResource S.BtnMedia}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="#00000000" />
        <Setter Property="Foreground" Value="{DynamicResource B.MediaTextDim}" />
        <Setter Property="FontFamily" Value="{DynamicResource F.Icon}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.MediaBtnHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.MediaText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.MediaBtnPress}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 舞台顶栏里的小号图标按钮（28×28，间距更紧） -->
    <Style x:Key="S.BtnStage" TargetType="Button" BasedOn="{StaticResource S.BtnIconMedia}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ============================================================ 侧栏折叠把手
         贴在右侧信息栏左缘的一枚窄条（视频客户端那种）：收起后画面铺满整个宽度，
         只剩它还能把信息栏拉回来。
         这里刻意用**主题色**而不是媒体色：它浮在窗口底上，不在恒黑的画面上。 -->
    <Style x:Key="S.SideHandle" TargetType="Button">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontFamily" Value="{DynamicResource F.Icon}" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="Background" Value="{DynamicResource B.SurfaceHi}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 左侧导航（设置窗口） -->
    <Style x:Key="S.NavItem" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="b" Background="#00000000" CornerRadius="12" Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <!-- 图标字形走 Tag（"&#xE80F;" 这类），没设就只留一条窄缝 -->
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{DynamicResource F.Icon}" FontSize="14"
                                           Width="22" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- 选中指示：极光渐变的小竖条，从 8 高展开到 18 -->
                        <Border x:Name="mark" Width="3" Height="8" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource B.Accent}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.NavActive}" />
                            <Setter TargetName="mark" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="Height"
                                                         To="18" Duration="{StaticResource D.Normal}" />
                                        <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="{StaticResource D.Normal}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="Height"
                                                         To="8" Duration="{StaticResource D.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="{StaticResource D.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 分段选择
         容器是浅面药丸，选中项用强调色实心。 -->
    <Style x:Key="S.Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <!-- 内边距做成可覆盖的：九宫格那种自绘小格子要把 Padding 设成 0 -->
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="#00000000" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 开关（带滑动动效 + 滑块轻微回弹） -->
    <Style x:Key="S.Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="46" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Height" Value="26" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="46" Height="26" Background="Transparent">
                        
                        <Border x:Name="track" CornerRadius="13" Background="{DynamicResource B.SwitchTrackOff}" />
                        <Border x:Name="knob" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Left"
                                Margin="3,0,0,0" Background="{DynamicResource B.SwitchKnob}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="knobScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource B.Accent}" />

                            <!-- 静态值兜底：位移只靠 EnterActions 动画的话，若动画被跳过
                                 （模板在外观就绪后才应用、或系统关了动画）滑块会停在左边，"已开"却画成"关"。 -->
                            <Setter TargetName="knob" Property="Margin" Value="23,0,0,0" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Margin"
                                                            To="23,0,0,0" Duration="0:0:0.18">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="Margin"
                                                            To="3,0,0,0" Duration="0:0:0.18">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="track" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 滑杆 -->
    <Style x:Key="S.Slider" TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource B.SurfacePress}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="{DynamicResource B.Surface}" />
                                                <Ellipse Fill="{DynamicResource B.Accent}" Margin="3" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 媒体语境的滑杆（音量弹层）：舞台恒黑，用主题色会变成浅底压黑画面，
         所以轨道/滑块走 B.Media* 那一套（深浅主题取值相同）。 -->
    <Style x:Key="S.SliderMedia" TargetType="Slider" BasedOn="{StaticResource S.Slider}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource B.MediaOk}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource B.MediaBtn}" VerticalAlignment="Center" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Ellipse Fill="#FF101317" />
                                                <Ellipse Fill="{DynamicResource B.MediaText}" Margin="3" />
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 输入框 -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Background" Value="{DynamicResource B.BgSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.AccentLine}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.GlassLine}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 下拉框（默认 WPF 那套太出戏，整个重画） -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="b" Background="#00000000" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.BgSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10" />
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="11,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                              Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource B.TextFaint}" StrokeThickness="1.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="4"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" Focusable="False">
                            <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Line}"
                                    BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,8,8"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 勾选框 -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="6" VerticalAlignment="Center"
                                Background="{DynamicResource B.BgSoft}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1.4">
                            <Path x:Name="check" Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed"
                                  Data="M0,4 L3.4,7.4 L9,0.6" Stroke="{DynamicResource B.AccentText}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource B.Accent}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 滚动条（细，悬停变宽） -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="tb" Background="{DynamicResource B.ScrollThumb}" CornerRadius="4" Margin="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="tb" Property="Margin" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- 属性元素必须放在所有 Setter 之后，否则 XAML 编译期报 MC3088 -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================================================ 密码框（跟输入框同款外观） -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Background" Value="{DynamicResource B.BgSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.AccentLine}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource B.AccentLine}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 弹窗里的大输入框 / 大密码框（38 高，和底部按钮同高） -->
    <Style x:Key="S.Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="S.FieldPwd" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
        <Setter Property="Height" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============================================================ 列表（加密库左栏） -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource S.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="b" Background="#00000000" CornerRadius="11" Padding="6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.SurfaceHi}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource B.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ 提示气泡 -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            CornerRadius="10" Padding="11,8" MaxWidth="360">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
