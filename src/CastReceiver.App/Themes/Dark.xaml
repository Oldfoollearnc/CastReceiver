<!-- 深色主题（默认）：中性近黑，不用渐变；层级靠"面"的明度差，不靠阴影 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Name">Dark</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Label">深色</sys:String>

    <!-- 底层画布 → 内容面 → 卡片 → 抬起/悬停：四级明度，差一点点就够 -->
    <SolidColorBrush x:Key="B.Bg" Color="#0A0B0D" />
    <SolidColorBrush x:Key="B.BgSoft" Color="#101214" />
    <SolidColorBrush x:Key="B.Surface" Color="#17191D" />
    <SolidColorBrush x:Key="B.SurfaceHi" Color="#1F2227" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#272B31" />
    <SolidColorBrush x:Key="B.SurfacePress" Color="#31363D" />
    <SolidColorBrush x:Key="B.Line" Color="#25292F" />
    <SolidColorBrush x:Key="B.LineSoft" Color="#1B1E22" />
    <SolidColorBrush x:Key="B.Text" Color="#EDEEF1" />
    <SolidColorBrush x:Key="B.TextDim" Color="#A5ABB4" />
    <!-- 会当正文/说明文字用，须在 B.Surface / B.Bg / B.BgSoft 上 ≥4.5:1；#868D96 实测最低 5.25:1，且仍比 TextDim 暗以保住层级。
         （旧值 #6E757E 最低只有 3.78:1。） -->
    <SolidColorBrush x:Key="B.TextFaint" Color="#868D96" />
    <SolidColorBrush x:Key="B.Ok" Color="#34D399" />
    <SolidColorBrush x:Key="B.Warn" Color="#F2B455" />
    <SolidColorBrush x:Key="B.Bad" Color="#F87171" />
    <SolidColorBrush x:Key="B.Accent" Color="#3DDC97" />
    <SolidColorBrush x:Key="B.AccentText" Color="#06251A" />
    <!-- 强调色的两种弱化：底色（选中/标签）与描边（聚焦环）—— 运行时跟着强调色走，见 App.ApplyAccent -->
    <SolidColorBrush x:Key="B.AccentSoft" Color="#243DDC97" />
    <SolidColorBrush x:Key="B.AccentLine" Color="#663DDC97" />
    <SolidColorBrush x:Key="B.FocusRing" Color="#553DDC97" />
    <SolidColorBrush x:Key="B.VideoBg" Color="#000000" />
    <SolidColorBrush x:Key="B.OverlayBg" Color="#E6121418" />
    <SolidColorBrush x:Key="B.OverlayBgSoft" Color="#CC0E1013" />
    <SolidColorBrush x:Key="B.SwitchTrackOff" Color="#343A42" />
    <SolidColorBrush x:Key="B.SwitchKnob" Color="#D8DBE0" />
    <SolidColorBrush x:Key="B.ScrollThumb" Color="#2C3138" />
    <SolidColorBrush x:Key="B.BusyOverlay" Color="#F00A0B0D" />
    <SolidColorBrush x:Key="B.WindowMica" Color="#D90A0B0D" />

    <!-- 媒体语境浮层（悬浮控制条 / 通讯状态卡 / 小窗控制条）：刻意**不跟主题**。
         舞台永远是黑的，浅色主题若沿用主题色，浮层会变成近乎不透明的白条压在黑画面上——刺眼，也失去"浮在视频之上"的语意。
         这几个键在深浅两套主题里取值完全相同，切主题不会影响它们。改色请两套同步改。 -->
    <SolidColorBrush x:Key="B.MediaBar" Color="#E6121418" />
    <SolidColorBrush x:Key="B.MediaBarSoft" Color="#CC0E1013" />
    <SolidColorBrush x:Key="B.MediaLine" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="B.MediaText" Color="#EDEEF1" />
    <SolidColorBrush x:Key="B.MediaTextDim" Color="#A5ABB4" />
    <SolidColorBrush x:Key="B.MediaBtn" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="B.MediaBtnHover" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="B.MediaBtnPress" Color="#4DFFFFFF" />
    <!-- 浮层里的曲线/状态点也要用"暗底友好"的一套：浅色主题的 Ok(#0F7A3D) 放在近黑浮层上几乎看不见 -->
    <SolidColorBrush x:Key="B.MediaOk" Color="#34D399" />
    <SolidColorBrush x:Key="B.MediaWarn" Color="#F2B455" />
    <SolidColorBrush x:Key="B.MediaBad" Color="#F87171" />

    <!-- 原生启动闪屏（GDI 用，写成 #RRGGBB 便于代码解析） -->
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashBg">#0A0B0D</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashFg">#EDEEF1</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashDim">#A5ABB4</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashLine">#25292F</sys:String>
</ResourceDictionary>
