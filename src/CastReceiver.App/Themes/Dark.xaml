<!-- 深色主题（默认）：中性近黑，不用渐变 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Name">Dark</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.Label">深色</sys:String>

    <SolidColorBrush x:Key="B.Bg" Color="#0B0C0E" />
    <SolidColorBrush x:Key="B.BgSoft" Color="#0E1013" />
    <SolidColorBrush x:Key="B.Surface" Color="#131519" />
    <SolidColorBrush x:Key="B.SurfaceHi" Color="#1A1D22" />
    <SolidColorBrush x:Key="B.SurfaceHover" Color="#22262C" />
    <SolidColorBrush x:Key="B.Line" Color="#262A30" />
    <SolidColorBrush x:Key="B.LineSoft" Color="#1D2126" />
    <SolidColorBrush x:Key="B.Text" Color="#ECEDEF" />
    <SolidColorBrush x:Key="B.TextDim" Color="#A0A6AE" />
    <SolidColorBrush x:Key="B.TextFaint" Color="#6B7178" />
    <SolidColorBrush x:Key="B.Ok" Color="#3DDC97" />
    <SolidColorBrush x:Key="B.Warn" Color="#F0B45E" />
    <SolidColorBrush x:Key="B.Bad" Color="#F0736A" />
    <SolidColorBrush x:Key="B.Accent" Color="#ECEDEF" />
    <SolidColorBrush x:Key="B.AccentText" Color="#0B0C0E" />
    <SolidColorBrush x:Key="B.VideoBg" Color="#000000" />
    <SolidColorBrush x:Key="B.OverlayBg" Color="#E6121418" />
    <SolidColorBrush x:Key="B.OverlayBgSoft" Color="#CC0E1013" />
    <SolidColorBrush x:Key="B.SwitchTrackOff" Color="#2A2F36" />
    <SolidColorBrush x:Key="B.SwitchKnob" Color="#C9CCD1" />
    <SolidColorBrush x:Key="B.ScrollThumb" Color="#2E333A" />
    <SolidColorBrush x:Key="B.BusyOverlay" Color="#F00B0C0E" />
    <SolidColorBrush x:Key="B.WindowMica" Color="#D90B0C0E" />

    <!-- 原生启动闪屏（GDI 用，写成 #RRGGBB 便于代码解析） -->
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashBg">#0B0C0E</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashFg">#ECEDEF</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashDim">#A0A6AE</sys:String>
    <sys:String xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="T.SplashLine">#262A30</sys:String>
</ResourceDictionary>