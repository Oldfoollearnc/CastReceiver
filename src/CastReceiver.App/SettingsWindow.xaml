                                            <Grid>
                                                <Slider x:Name="SldIntroExtend" Style="{DynamicResource S.Slider}" Minimum="0" Maximum="30"
                                                        Value="0" Margin="0,4,60,0" ValueChanged="SldIntroExtend_ValueChanged"
                                                        AutomationProperties.Name="入场动画延长秒数" />
                                                <TextBlock x:Name="TxtIntroExtendValue" Style="{DynamicResource S.Mono}" FontSize="11.5"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Text="0 秒" />
