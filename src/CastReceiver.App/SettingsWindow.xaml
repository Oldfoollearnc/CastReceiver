                                        <TextBox x:Name="TxtIntroFadeOut" Width="76" Height="30" Margin="6,0,0,0" Padding="4,2" TextAlignment="Center" IsReadOnly="False"
                                                 AutomationProperties.Name="出场毫秒" />
                                        <TextBlock Text="ms" FontSize="12.5" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource B.TextFaint}" />
                                        <CheckBox x:Name="ChkIntroFlash" Content="出场白闪" Margin="14,0,0,0" VerticalAlignment="Center"
                                                  Click="IntroStyle_Changed" AutomationProperties.Name="出场白闪" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnIntroPreview" Content="预览（像重进一次）" Style="{DynamicResource S.Btn}" Padding="16,6" FontSize="12"
                                            Click="BtnIntroPreview_Click" AutomationProperties.Name="预览入场动画"
                                            AutomationProperties.AutomationId="IntroPreviewButton" />
                                    <CheckBox x:Name="ChkIntroReenter" Content="藏起界面再播" Margin="12,0,0,0" VerticalAlignment="Center"
                                              Click="IntroStyle_Changed" AutomationProperties.Name="预览时藏起界面" />
                                    <TextBlock x:Name="TxtIntroHint" Text="" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"
