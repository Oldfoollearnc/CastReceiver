<Window x:Class="CastReceiver.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置" Height="620" Width="880" MinHeight="520" MinWidth="760"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="设置" FontSize="13.5" FontWeight="SemiBold" Margin="20,0,0,0" VerticalAlignment="Center" />
                <Button Content="&#xE8BB;" Style="{DynamicResource S.BtnIcon}" HorizontalAlignment="Right" Margin="0,0,10,0"
                        Click="BtnClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭" ToolTip="关闭（Esc）" />
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="12,4,6,12">
                    <RadioButton x:Name="NavGeneral" Style="{DynamicResource S.NavItem}" GroupName="nav" IsChecked="True"
                                 Content="通用" AutomationProperties.Name="通用" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavVisual" Style="{DynamicResource S.NavItem}" GroupName="nav"
                                 Content="画面" AutomationProperties.Name="画面" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavNetwork" Style="{DynamicResource S.NavItem}" GroupName="nav"
                                 Content="网络" AutomationProperties.Name="网络" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavSecurity" Style="{DynamicResource S.NavItem}" GroupName="nav"
                                 Content="安全" AutomationProperties.Name="安全" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavDiag" Style="{DynamicResource S.NavItem}" GroupName="nav"
                                 Content="诊断" AutomationProperties.Name="诊断" Checked="Nav_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{DynamicResource S.NavItem}" GroupName="nav"
                                 Content="关于" AutomationProperties.Name="关于" Checked="Nav_Checked" />
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource B.BgSoft}" BorderBrush="{DynamicResource B.Line}"
                        BorderThickness="1,0,0,0" Padding="24,18,24,18">
                    <Grid>

                        <!-- 通用 -->
                        <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="外观" FontSize="13" FontWeight="SemiBold" />
                                <Border Style="{DynamicResource S.Card}" Padding="4" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Background="{DynamicResource B.SurfaceHi}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SegDark" Style="{DynamicResource S.Segment}" GroupName="theme" Content="深色"
                                                     AutomationProperties.Name="深色" Checked="Theme_Checked" Tag="Dark" />
                                        <RadioButton x:Name="SegLight" Style="{DynamicResource S.Segment}" GroupName="theme" Content="浅色"
                                                     AutomationProperties.Name="浅色" Checked="Theme_Checked" Tag="Light" />
                                        <RadioButton x:Name="SegSystem" Style="{DynamicResource S.Segment}" GroupName="theme" Content="跟随系统"
                                                     AutomationProperties.Name="跟随系统" Checked="Theme_Checked" Tag="System" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="设备" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,0" />
                                <TextBlock Text="手机投屏列表里显示的名称" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,8,0,0" />
                                <TextBox x:Name="TxtName" Margin="0,6,0,0" HorizontalAlignment="Left" Width="300" TextChanged="TxtName_TextChanged" />

                                <TextBlock Text="行为" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="启动时自动开启接收端" FontSize="13" />
                                        <TextBlock Text="打开程序即开始等待手机连接" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwAutoStart" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="启动时自动开启接收端" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="手机连接时需要本机确认" FontSize="13" />
                                        <TextBlock Text="更安全，但每次连接都要点一下" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwConfirm" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="手机连接时需要本机确认" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="镜像静音" FontSize="13" />
                                        <TextBlock Text="把手机传来的声音静音，可进一步降低延迟" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwMute" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="镜像静音" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="AirPlay 接收（iPhone / iPad）" FontSize="13" />
                                        <TextBlock Text="让 iPhone/iPad 也能投屏到本机；安卓手机仍走「无线投屏」(Miracast)，两条链路互不影响" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwAirPlay" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="AirPlay 接收" />
                                </Grid>

                                <TextBlock Text="音频输出" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="投屏时自动切换音频输出" FontSize="13" />
                                        <TextBlock Text="投屏开始时把声音切到指定设备；安卓与苹果都适用" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwAudioSwitch" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="投屏时自动切换音频输出" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="切换到" FontSize="13" />
                                        <TextBlock x:Name="TxtAudioHint" Text="选择投屏时使用的播放设备" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbAudioTarget" Width="224" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              SelectionChanged="AudioTarget_Changed" AutomationProperties.Name="投屏时切换到的音频设备" />
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="结束后还原原来的设备" FontSize="13" />
                                        <TextBlock Text="关闭则投屏结束后保留在该设备上" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwAudioRestore" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="投屏结束后还原音频设备" />
                                </Grid>

                                <TextBlock Text="强调色" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,0" />
                                <StackPanel x:Name="AccentRow" Orientation="Horizontal" Margin="0,10,0,0" />

                                <TextBlock Text="界面密度" FontSize="13" FontWeight="SemiBold" Margin="0,22,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="SegComfortable" Style="{DynamicResource S.Segment}" GroupName="density" Content="舒适"
                                                 AutomationProperties.Name="舒适" Checked="Density_Checked" Tag="Comfortable" />
                                    <RadioButton x:Name="SegCompact" Style="{DynamicResource S.Segment}" GroupName="density" Content="紧凑"
                                                 AutomationProperties.Name="紧凑" Checked="Density_Checked" Tag="Compact" />
                                </StackPanel>

                                <TextBlock Text="系统集成" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="关闭窗口时最小化到托盘" FontSize="13" />
                                        <TextBlock Text="关掉它则关闭窗口直接退出程序" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwTray" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="关闭窗口时最小化到托盘" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="开机自动启动" FontSize="13" />
                                        <TextBlock Text="登录 Windows 后自动在后台待命" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwStartup" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="开机自动启动" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="连接与断开时提示" FontSize="13" />
                                        <TextBlock Text="播放提示音并弹出托盘气泡" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwNotify" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="连接与断开时提示" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="全局快捷键" FontSize="13" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwHotkeys" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="全局快捷键" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="云母材质背景（Win11）" FontSize="13" />
                                        <TextBlock Text="窗口背景半透明，观感更接近系统原生" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwMica" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="云母材质背景" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                    <Button Style="{DynamicResource S.Btn}" Content="使用引导" Click="BtnTutorial_Click" />
                                    <TextBlock x:Name="TxtSaved" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Text="改动会立即生效并自动保存" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 画面 -->
                        <ScrollViewer x:Name="PageVisual" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="画面适配" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="选择后立即生效，并且以后都按你的选择来（不会再被自动改掉）" FontSize="11.5"
                                           Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnFitFit" Content="适应" Style="{DynamicResource S.Btn}" Padding="14,7" Click="BtnFit_Click" Tag="Fit" />
                                    <Button x:Name="BtnFitFill" Content="铺满" Style="{DynamicResource S.Btn}" Padding="14,7" Margin="8,0,0,0" Click="BtnFit_Click" Tag="Fill" />
                                    <Button x:Name="BtnFitStretch" Content="拉伸" Style="{DynamicResource S.Btn}" Padding="14,7" Margin="8,0,0,0" Click="BtnFit_Click" Tag="Stretch" />
                                    <Button x:Name="BtnFitNative" Content="原始" Style="{DynamicResource S.Btn}" Padding="14,7" Margin="8,0,0,0" Click="BtnFit_Click" Tag="Native" />
                                </StackPanel>
                                <Border Style="{DynamicResource S.Card}" Padding="14" Margin="0,12,0,0">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" LineHeight="21">
                                        <Run Text="适应 · 完整显示，四周按需留黑（不变形不裁切）" /><LineBreak />
                                        <Run Text="铺满 · 等比放大填满，超出部分裁掉（不变形，但会裁掉边缘）" /><LineBreak />
                                        <Run Text="拉伸 · 强行拉满整块区域（填满且不裁切，但可能变形）" /><LineBreak />
                                        <Run Text="原始 · 1:1 像素不缩放，画面大于区域时裁切" />
                                    </TextBlock>
                                </Border>

                                <TextBlock Text="缩放" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,0" />
                                <Grid Margin="0,10,0,0" Width="380" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SldZoom" Grid.Column="0" Style="{DynamicResource S.Slider}" Minimum="50" Maximum="200"
                                            Value="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="SldZoom_ValueChanged" />
                                    <TextBlock x:Name="TxtZoomValue" Grid.Column="1" Width="52" TextAlignment="Right" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{DynamicResource B.TextDim}" FontFamily="{DynamicResource F.Mono}" Text="100%" />
                                </Grid>
                                <Button Content="缩放复位到 100%" Style="{DynamicResource S.Btn}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                        Click="BtnZoomReset_Click" />

                                <TextBlock Text="画质档位" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,0" />
                                <TextBlock Text="向手机申请的分辨率与码率：越低越跟手，越高越清晰" FontSize="11.5"
                                           Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnQualityLow" Content="低延迟" Style="{DynamicResource S.Btn}" Padding="14,7" Click="BtnQuality_Click" Tag="LowLatency" />
                                    <Button x:Name="BtnQualityBalanced" Content="均衡" Style="{DynamicResource S.Btn}" Padding="14,7" Margin="8,0,0,0" Click="BtnQuality_Click" Tag="Balanced" />
                                    <Button x:Name="BtnQualityHigh" Content="高画质" Style="{DynamicResource S.Btn}" Padding="14,7" Margin="8,0,0,0" Click="BtnQuality_Click" Tag="HighQuality" />
                                </StackPanel>

                                <TextBlock Text="全屏" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="手机连上后自动进入全屏" FontSize="13" />
                                        <TextBlock Text="适合当电视用；断开时自动退出全屏" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwAutoFullscreen" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="手机连上后自动进入全屏" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="全屏时自动隐藏鼠标" FontSize="13" />
                                        <TextBlock Text="3 秒不动鼠标指针就消失，动一下立刻恢复" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwHideCursor" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                AutomationProperties.Name="全屏时自动隐藏鼠标" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource B.LineSoft}" Margin="0,12,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="全屏时阻止屏保与休眠" FontSize="13" />
                                        <TextBlock Text="长时间观看不会被系统息屏打断" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwPreventSleep" Style="{DynamicResource S.Switch}" Checked="Setting_Changed" Unchecked="Setting_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  AutomationProperties.Name="全屏时阻止屏保与休眠" />
                                </Grid>

                                <TextBlock Text="加密库（截图与录像）" FontSize="13" FontWeight="SemiBold" Margin="0,24,0,0" />
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.TextDim}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"
                                           Text="截图与录像不再以明文文件保存：内容加密后放在下面的库里，只有本程序能用账号密码解开。库位置随 Windows 用户隔离，也不会被云盘同步。" />
                                <TextBox x:Name="TxtVaultPath" Margin="0,8,0,0" IsReadOnly="True" FontFamily="{DynamicResource F.Mono}" FontSize="11" />
                                <TextBlock x:Name="TxtVaultState" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="打开我的库" Style="{DynamicResource S.BtnPrimary}" Click="BtnOpenVault_Click" />
                                    <Button Content="锁定" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="BtnLockVault_Click" />
                                    <Button Content="打开旧明文目录" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="BtnOpenCaptureFolder_Click"
                                            ToolTip="旧版本把明文截图/录像放在这里（新版不再写入）" />
                                </StackPanel>

                                <TextBlock Text="录像参数" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="帧率" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
                                    <ComboBox x:Name="CmbRecordFps" Width="80" Margin="8,0,0,0" SelectionChanged="RecordOption_Changed" />
                                    <TextBlock Text="画质" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" Margin="18,0,0,0" />
                                    <ComboBox x:Name="CmbRecordQuality" Width="110" Margin="8,0,0,0" SelectionChanged="RecordOption_Changed" />
                                    <TextBlock Text="单条上限" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" Margin="18,0,0,0" />
                                    <ComboBox x:Name="CmbRecordMinutes" Width="100" Margin="8,0,0,0" SelectionChanged="RecordOption_Changed" />
                                </StackPanel>
                                <TextBlock x:Name="TxtRecordEstimate" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                <TextBlock Text="库容量与保留" FontSize="12.5" FontWeight="SemiBold" Margin="0,18,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="软配额" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
                                    <ComboBox x:Name="CmbVaultQuota" Width="110" Margin="8,0,0,0" SelectionChanged="RecordOption_Changed" />
                                    <TextBlock Text="保留策略" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" Margin="18,0,0,0" />
                                    <ComboBox x:Name="CmbVaultRetention" Width="130" Margin="8,0,0,0" SelectionChanged="RecordOption_Changed" />
                                    <TextBlock Text="库空闲上锁" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" Margin="18,0,0,0" />
                                    <ComboBox x:Name="CmbIdleLock" Width="110" Margin="8,0,0,0" SelectionChanged="RecordOption_Changed" />
                                </StackPanel>

                                <Grid Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="退出程序时清空整个加密库" FontSize="13" />
                                        <TextBlock Text="所有账号的全部截图与录像都会被删除，不可恢复" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="SwClearOnExit" Style="{DynamicResource S.Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Checked="Setting_Changed" Unchecked="Setting_Changed" AutomationProperties.Name="退出时清空加密库" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="导入旧明文文件" Style="{DynamicResource S.Btn}" Click="BtnImportLegacy_Click" />
                                    <Button Content="删除旧明文文件" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="BtnClearCaptures_Click" />
