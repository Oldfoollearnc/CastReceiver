                                            <Slider x:Name="SldIntroFadeOut" Style="{DynamicResource S.Slider}" Minimum="100" Maximum="3000"
                                                    Value="880" Margin="0,2,2,0" ValueChanged="IntroFade_Changed"
                                                    AutomationProperties.Name="出场毫秒" />
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="进场 / 出场" Style="{DynamicResource S.Caption}" />
                                                <TextBlock x:Name="TxtIntroFade" Style="{DynamicResource S.Mono}" FontSize="11.5"
                                                           HorizontalAlignment="Right" Text="760 / 880 ms" />
