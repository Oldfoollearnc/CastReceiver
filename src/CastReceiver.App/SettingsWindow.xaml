                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBox x:Name="TxtIntroWidth" Width="92" Height="30" Padding="4,2" TextAlignment="Center" IsReadOnly="False"
                                                 AutomationProperties.Name="入场画面宽度" />
                                        <TextBlock Text="×" FontSize="12.5" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource B.TextFaint}" />
                                        <TextBox x:Name="TxtIntroHeight" Width="92" Height="30" Padding="4,2" TextAlignment="Center" IsReadOnly="False"
                                                 AutomationProperties.Name="入场画面高度" />
