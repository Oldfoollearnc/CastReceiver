                                    <ToggleButton x:Name="SwLockOnSessionLock" Style="{DynamicResource S.Switch}" HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                  AutomationProperties.Name="锁屏时自动上锁并遮挡画面" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="空闲时自动刷新接收广播" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
                                    <ComboBox x:Name="CmbIdleRefresh" Width="150" Margin="8,0,0,0" SelectionChanged="SecurityOption_Changed" />
                                    <TextBlock Text="手机搜不到设备时自动刷新" FontSize="11.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBox x:Name="TxtAntiCaptureReport" Margin="0,10,0,0" Height="130" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource F.Mono}" FontSize="11"
                                         Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.TextDim}"
                                         BorderBrush="{DynamicResource B.Line}" />

                                <TextBlock Text="隐私体检" Style="{DynamicResource S.H2}" Margin="0,24,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="重新体检" Style="{DynamicResource S.Btn}" Click="BtnCheckup_Click" />
                                    <Button Content="关闭 Game Bar 后台录制" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="BtnFixGameBar_Click" />
                                </StackPanel>
                                <TextBox x:Name="TxtCheckup" Margin="0,10,0,0" Height="200" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" FontSize="11.5"
                                         Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.TextDim}"
                                         BorderBrush="{DynamicResource B.Line}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 诊断 -->
                        <Grid x:Name="PageDiag" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{DynamicResource S.H1}" Text="诊断" />
                                <TextBlock Style="{DynamicResource S.Desc}" Text="自检、日志与连接体检" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="BtnSelfTest" Content="运行自检" Style="{DynamicResource S.BtnPrimary}" Click="BtnSelfTest_Click" />
                                <Button x:Name="TabResults" Content="自检结果" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="DiagTab_Click" Tag="results" />
                                <Button x:Name="TabLog" Content="运行日志" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="DiagTab_Click" Tag="log" />
                                <Button x:Name="TabEvents" Content="动态" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="DiagTab_Click" Tag="events" />
                                <Button Content="一键连接诊断" Style="{DynamicResource S.Btn}" Margin="16,0,0,0" Click="BtnWizard_Click" />
                                <Button Content="导出诊断包" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="BtnExport_Click" />
                                <TextBlock x:Name="TxtSummary" FontSize="12" Foreground="{DynamicResource B.TextDim}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Grid.Row="2" Style="{DynamicResource S.Card}" Padding="12" Margin="0,14,0,0">
                                <Grid>
                                    <ScrollViewer x:Name="ViewResults" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="LstResults">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="46" />
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Result}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{Binding Color}" FontFamily="{DynamicResource F.Mono}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="ViewLog" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtLog" FontFamily="{DynamicResource F.Mono}" FontSize="11"
                                                   Foreground="{DynamicResource B.TextFaint}" TextWrapping="Wrap" LineHeight="17" />
                                    </ScrollViewer>
                                    <ScrollViewer x:Name="ViewEvents" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtEvents" FontFamily="{DynamicResource F.Mono}" FontSize="11"
                                                   Foreground="{DynamicResource B.TextFaint}" TextWrapping="Wrap" LineHeight="18" />
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- 关于 -->
                        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource S.H1}" Text="关于" />
                                <TextBlock Style="{DynamicResource S.Desc}" Text="版本、运行方式与更新源" Margin="0,5,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Image Source="app.ico" Width="56" Height="56" VerticalAlignment="Top" />
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="投屏Window 桌面版" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtVersion" FontSize="12" Foreground="{DynamicResource B.TextDim}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{DynamicResource S.Card}" Padding="16,14" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="开发者" FontSize="12" Foreground="{DynamicResource B.TextDim}" />
                                            <TextBlock Text="猪猪" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Style="{DynamicResource S.Divider}" Margin="0,10" />
                                        <Grid>
                                            <TextBlock Text="版本" FontSize="12" Foreground="{DynamicResource B.TextDim}" />
                                            <TextBlock x:Name="TxtVersion2" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Border Style="{DynamicResource S.Divider}" Margin="0,10" />
                                        <Grid>
                                            <TextBlock Text="运行方式" FontSize="12" Foreground="{DynamicResource B.TextDim}" />
                                            <TextBlock x:Name="TxtRuntime" FontSize="12" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="更新源" Style="{DynamicResource S.H2}" Margin="0,24,0,0" />
                                <TextBlock Style="{DynamicResource S.Desc}" Text="填一个返回 JSON 的地址；留空则用官方更新源" Margin="0,6,0,0" />
                                <TextBox x:Name="TxtUpdateUrl" Margin="0,8,0,0" HorizontalAlignment="Left" Width="420" AutomationProperties.Name="更新源地址"
                                         ToolTip="一个返回 JSON 的地址，形如 {&quot;version&quot;:&quot;1.1.0&quot;,&quot;url&quot;:&quot;下载页&quot;}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="保存" Style="{DynamicResource S.Btn}" Click="BtnSaveUpdate_Click" />
                                    <Button x:Name="BtnCheckUpdate" Content="检查更新" Style="{DynamicResource S.Btn}" Margin="8,0,0,0" Click="BtnCheckUpdate_Click" />
                                    <TextBlock x:Name="TxtUpdateResult" FontSize="12" Foreground="{DynamicResource B.TextDim}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
