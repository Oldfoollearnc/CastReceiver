                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="进场" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
                                        <TextBox x:Name="TxtIntroFadeIn" Width="76" Height="30" Margin="6,0,0,0" Padding="4,2" TextAlignment="Center" IsReadOnly="False"
