                                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,12,0,0" TextWrapping="Wrap">
                                    首次使用需要放行防火墙并把当前 Wi-Fi 设为专用网络，否则手机的投屏列表里看不到本机。只需做一次。
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
