                                                <RadioButton Background="{DynamicResource B.SurfaceHi}" x:Name="PosIntro8" Style="{DynamicResource S.Segment}" GroupName="intropos" Tag="1,1"
                                                             Padding="0" Width="24" Height="24" Checked="IntroPos_Checked" AutomationProperties.Name="位置 右下">
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource B.Text}" />
                                                </RadioButton>
                                            </UniformGrid>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="声音" Style="{DynamicResource S.Caption}" />
