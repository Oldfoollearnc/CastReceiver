                                                  VerticalAlignment="Center" Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                  AutomationProperties.Name="锁屏时自动上锁并遮挡画面" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="空闲时自动刷新接收广播" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
