                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音量" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource B.TextFaint}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
