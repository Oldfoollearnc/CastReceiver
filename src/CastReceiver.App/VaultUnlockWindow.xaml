<Window x:Class="CastReceiver.App.VaultUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="解锁我的库" Height="520" Width="560"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Path Width="14" Height="16" Stretch="Uniform" Fill="{DynamicResource B.TextDim}" VerticalAlignment="Center"
                          Data="M6,7 V5 A4,4 0 0 1 14,5 V7 H15.5 A1,1 0 0 1 16.5,8 V17 A1,1 0 0 1 15.5,18 H4.5 A1,1 0 0 1 3.5,17 V8 A1,1 0 0 1 4.5,7 Z M8,7 H12 V5 A2,2 0 0 0 8,5 Z" />
                    <TextBlock Text="解锁我的库" Style="{DynamicResource S.H1}" Margin="9,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="&#xE8BB;" Style="{DynamicResource S.BtnClose}" HorizontalAlignment="Right" Margin="0,0,8,0"
                        Click="BtnCancel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        AutomationProperties.Name="关闭" ToolTip="关闭（Esc）" />
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="26,4,26,0">
                <TextBlock FontSize="12" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap" LineHeight="19"
                           Text="查看截图与录像需验证密码；密码只在本机使用，不会上传。" />

                <!-- 账号 -->
                <TextBlock Text="账号" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,20,0,0" />
                <Grid Margin="0,7,0,0">
                    <Border x:Name="AccountDisplay" Height="38" CornerRadius="8" Background="{DynamicResource B.SurfaceHi}"
                            BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
                        <Grid Margin="10,0">
                            <TextBlock x:Name="TxtAccountName" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtAccountEmpty" FontSize="13" Foreground="{DynamicResource B.TextFaint}"
                                       VerticalAlignment="Center" Text="（还没有账号）" Visibility="Collapsed" />
                            <Button x:Name="BtnSwitchAccount" Content="换账号" Style="{DynamicResource S.Btn}" Padding="9,4" FontSize="11.5"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnSwitchAccount_Click"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ComboBox x:Name="CmbUser" Height="38" IsEditable="True" FontSize="13" Padding="8,0" Visibility="Collapsed"
                              AutomationProperties.Name="账号"
                              Background="{DynamicResource B.SurfaceHi}" Foreground="{DynamicResource B.Text}"
                              BorderBrush="{DynamicResource B.Line}" />
                </Grid>
                <TextBlock x:Name="TxtAccountHint" FontSize="11" Foreground="{DynamicResource B.TextFaint}" Margin="0,6,0,0"
                           TextWrapping="Wrap" Text="创建账号时设置的名字。" />

                <!-- 密码 -->
                <TextBlock Text="密码" FontSize="12" Foreground="{DynamicResource B.TextFaint}" Margin="0,16,0,0" />
                <Grid Margin="0,7,0,0">
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource S.FieldPwd}" AutomationProperties.Name="解锁密码"
                                 CaretBrush="{DynamicResource B.Text}" PasswordChar="●"
                                 PasswordChanged="Password_Changed" KeyDown="Password_KeyDown" />
                    <TextBlock x:Name="PhPassword" Text="输入密码" FontSize="13" Foreground="{DynamicResource B.TextFaint}"
                               Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button x:Name="BtnPeek" Content="显示" Style="{DynamicResource S.Btn}" Padding="9,4" FontSize="11.5"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Click="BtnPeek_Click"
                            ToolTip="临时显示密码" />
                </Grid>

                <!-- 错误 -->
                <Border x:Name="ErrorBox" CornerRadius="8" Background="{DynamicResource B.SurfaceHi}" Padding="11,9" Margin="0,14,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource B.Bad}" VerticalAlignment="Top" Margin="0,1,0,0"
                              Data="M10,2 A8,8 0 1 1 9.99,2 Z M9,5 H11 V12 H9 Z M9,14 H11 V16 H9 Z" />
                        <TextBlock x:Name="TxtError" FontSize="12" Foreground="{DynamicResource B.Bad}" TextWrapping="Wrap"
                                   Margin="9,0,0,0" LineHeight="18" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="TxtDevice" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}" Margin="0,14,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed" />

                <Button x:Name="BtnForgot" Content="忘记密码？" Style="{DynamicResource S.Btn}" Padding="10,5" FontSize="11.5"
                        HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnForgot_Click" />
            </StackPanel>

            <!-- 底栏 -->
            <Grid Grid.Row="2" Margin="26,16,26,20">
                <TextBlock FontSize="11" Foreground="{DynamicResource B.TextFaint}" VerticalAlignment="Center"
                           Text="Ctrl+Alt+L 可随时上锁" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{DynamicResource S.Btn}" Padding="18,8" FontSize="12.5" Click="BtnCancel_Click" />
                    <Button x:Name="BtnUnlock" Content="解锁" Style="{DynamicResource S.BtnPrimary}" Padding="24,8" FontSize="12.5"
                            Margin="10,0,0,0" Click="BtnUnlock_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
