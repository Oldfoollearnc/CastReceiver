<Window x:Class="CastReceiver.App.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="我的库" Height="740" Width="1140" MinHeight="560" MinWidth="920"
        Background="{DynamicResource B.Bg}" Foreground="{DynamicResource B.Text}"
        FontFamily="{DynamicResource F.Ui}" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True" ShowInTaskbar="False">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource B.Bg}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowHeader" Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="RowFooter" Height="34" />
            </Grid.RowDefinitions>

            <!-- 顶栏 -->
            <Grid x:Name="Header" Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="我的库" Style="{DynamicResource S.H1}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtAccount" FontSize="12" Foreground="{DynamicResource B.TextDim}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtUnlocked" FontSize="11.5" Foreground="{DynamicResource B.Ok}"
                               Margin="10,0,0,0" VerticalAlignment="Center" Text="已解锁" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="BtnImport" Content="导入旧文件" Style="{DynamicResource S.Btn}" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" Click="BtnImport_Click" ToolTip="把旧版本留在图片/视频文件夹里的明文截图与录像导入加密库" />
                    <Button x:Name="BtnClear" Content="清空库" Style="{DynamicResource S.Btn}" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" Click="BtnClear_Click" />
                    <Button x:Name="BtnLock" Content="锁定" Style="{DynamicResource S.Btn}" Padding="12,6" FontSize="12"
                            Margin="0,0,8,0" Click="BtnLock_Click" ToolTip="立即清除内存中的密钥并关闭库" />
                    <Button Content="&#xE8BB;" Style="{DynamicResource S.BtnClose}" Click="BtnClose_Click"
                            AutomationProperties.Name="关闭" ToolTip="关闭并锁定（Esc）" />
                </StackPanel>
            </Grid>

            <!-- 主体 -->
            <Grid x:Name="Body" Grid.Row="1" Margin="16,4,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColList" Width="304" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ListCard" Grid.Column="0" Style="{DynamicResource S.Card}" Margin="0,0,12,0" Padding="6">
                    <Grid>
                        <ListBox x:Name="LstItems" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource B.Text}" SelectionChanged="LstItems_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="54" Background="#000000" CornerRadius="3">
                                            <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource B.TextFaint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="TxtEmpty" FontSize="12" Foreground="{DynamicResource B.TextFaint}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="18" Visibility="Collapsed"
                                   Text="库里还没有内容。&#x0a;&#x0a;投屏时点「截屏」或「录制」，内容会加密保存到这里。" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PreviewCard" Grid.Row="0" Background="#000000" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock x:Name="TxtPreviewHint" FontSize="12.5" Foreground="#A0A6AE"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="从左侧选择一条内容" />
                        </Grid>
                    </Border>

                    <Border x:Name="Transport" Grid.Row="1" Style="{DynamicResource S.Card}" Padding="12,8" Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnPlay" Content="&#xE768;" FontFamily="{DynamicResource F.Icon}" FontSize="13"
                                    Style="{DynamicResource S.Btn}" Padding="10,4" Click="BtnPlay_Click"
                                    AutomationProperties.Name="播放/暂停" ToolTip="播放 / 暂停（空格）" />
                            <Slider x:Name="SldProgress" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                                    Style="{DynamicResource S.Slider}" Minimum="0" Maximum="1" IsSnapToTickEnabled="True"
                                    TickFrequency="1" ValueChanged="SldProgress_ValueChanged"
                                    PreviewMouseLeftButtonUp="SldProgress_MouseUp" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFrame" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                                           FontFamily="{DynamicResource F.Mono}" VerticalAlignment="Center" MinWidth="92" />
                                <Button x:Name="BtnSpeed" Content="1.0×" Style="{DynamicResource S.Btn}" Padding="8,4" FontSize="11.5"
                                        Margin="8,0,0,0" Click="BtnSpeed_Click" ToolTip="播放速度" />
                                <Button x:Name="BtnFullscreen" Content="&#xE740;" FontFamily="{DynamicResource F.Icon}" FontSize="13"
                                        Style="{DynamicResource S.Btn}" Padding="10,4" Margin="8,0,0,0" Click="BtnFullscreen_Click"
                                        AutomationProperties.Name="全屏" ToolTip="全屏（Esc 退出）" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{DynamicResource S.Card}" Padding="12,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtInfo" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                                       TextWrapping="Wrap" LineHeight="18" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBox x:Name="TxtTitle" Width="200" Padding="7,5" FontSize="12"
                                         Background="{DynamicResource B.Surface}" Foreground="{DynamicResource B.Text}"
                                         BorderBrush="{DynamicResource B.Line}" CaretBrush="{DynamicResource B.Text}"
                                         ToolTip="给这条内容起个名字（只保存在加密头里）" />
                                <Button Content="保存标题" Style="{DynamicResource S.Btn}" Padding="10,5" FontSize="11.5"
                                        Margin="8,0,0,0" Click="BtnRename_Click" />
                                <Button Content="删除" Style="{DynamicResource S.Btn}" Padding="10,5" FontSize="11.5"
                                        Margin="8,0,0,0" Click="BtnDelete_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底栏 -->
            <Grid x:Name="Footer" Grid.Row="2" Margin="16,0">
                <Border VerticalAlignment="Top" Height="1" Background="{DynamicResource B.LineSoft}" Margin="-16,0,-16,0" />
                <TextBlock x:Name="TxtStatus" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtHint" FontSize="11.5" Foreground="{DynamicResource B.TextFaint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="空格 播放/暂停 · ← → 逐帧 · Del 删除 · Esc 退出全屏" />
            </Grid>
        </Grid>
    </Border>
</Window>
